---
import { getFeatureConfig, getReadingConfig, INTEREST_TAGS } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";

export const prerender = true;

const features = getFeatureConfig();
const reading = getReadingConfig();
---

<BaseLayout
  title="个人中心 - 未名诗阁"
  description="Manage poetry reading preferences, saved poems, and subscriptions."
  canonicalPath="/me"
  robots="noindex,follow"
>
  <section class="section">
    <h1>个人中心</h1>
    {!features.login ? (
      <div class="panel">
        <p class="kicker">Account features are disabled</p>
        <p>登录、收藏、评论和个人偏好已经有数据结构和 API 边界，但当前环境没有启用登录服务。</p>
        <p>启用后，这里会展示阅读模式、兴趣标签、收藏诗词、阅读历史和邮件订阅状态。</p>
      </div>
    ) : (
      <div class="panel">
        <p class="kicker">Sign in required</p>
        <p>请输入邮箱接收登录链接。未登录时不会展示私人数据。</p>
        <form method="post" action="/api/auth/magic-link">
          <label>
            Email
            <input type="email" name="email" autocomplete="email" required />
          </label>
          <button type="submit">Send magic link</button>
        </form>
      </div>
    )}
  </section>

  <section class="section grid">
    <div>
      <h2 class="section-title">阅读偏好</h2>
      <form class="preference-form" method="post" action="/api/preferences">
        <label>
          阅读模式
          <select name="readingMode" disabled={!features.personalCenter}>
            {reading.modes.map((mode) => <option value={mode} selected={mode === reading.defaultMode}>{mode}</option>)}
          </select>
        </label>
        <label>
          注释语言
          <select name="helperLanguage" disabled={!features.personalCenter}>
            {
              reading.helperLanguages.map((language) => (
                <option value={language} selected={language === reading.defaultHelperLanguage}>{language}</option>
              ))
            }
          </select>
        </label>
        <label class="check-row">
          <input type="checkbox" name="emailDailyEnabled" value="true" disabled={!features.personalCenter} />
          每日邮件推荐
        </label>
        <button type="submit" disabled={!features.personalCenter}>保存偏好</button>
      </form>
    </div>
    <div>
      <h2 class="section-title">兴趣标签</h2>
      <div class="tags">
        {
          INTEREST_TAGS.map((tag) => (
            <label>
              <input type="checkbox" name="interestTags" value={tag.slug} disabled={!features.personalCenter} />
              {tag.labelZh} · {tag.labelEn}
            </label>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  h1 {
    color: var(--teal);
    font-size: 48px;
  }

  .panel {
    border: 1px solid var(--line);
    background: rgba(255, 249, 234, 0.68);
    max-width: 760px;
    padding: 20px;
  }

  .kicker {
    color: var(--cinnabar);
    font-weight: 700;
  }

  form,
  label {
    display: grid;
    gap: 10px;
  }

  input,
  select {
    border: 1px solid var(--line);
    padding: 12px;
  }

  button {
    width: fit-content;
    border: 0;
    background: var(--teal);
    color: var(--paper-2);
    padding: 12px 18px;
  }

  button:disabled,
  input:disabled,
  select:disabled {
    cursor: not-allowed;
    opacity: 0.58;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .preference-form {
    border: 1px solid var(--line);
    background: rgba(255, 249, 234, 0.58);
    padding: 18px;
  }

  .check-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .tags {
    display: grid;
    gap: 10px;
  }

  .tags label {
    border: 1px solid var(--line);
    padding: 8px 10px;
  }

  @media (max-width: 820px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
