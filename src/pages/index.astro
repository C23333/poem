---
import AdSlot from "@/components/AdSlot.astro";
import SubscriptionPanel from "@/components/SubscriptionPanel.astro";
import { getSiteConfig } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { websiteJsonLd } from "@/lib/seo/structured-data";

export const prerender = true;

const site = getSiteConfig();
---

<BaseLayout
  title="未名诗阁 - Chinese Poetry, Read in Two Languages"
  description="A bilingual Chinese classical poetry site with notes, translations, context, and daily recommendations."
  canonicalPath="/"
  jsonLd={websiteJsonLd({
    siteUrl: site.url,
    name: "未名诗阁",
    description: "A bilingual Chinese classical poetry site with notes, translations, context, and daily recommendations."
  })}
>
  <section class="hero">
    <div class="intro">
      <p class="kicker">For global readers · 可配置语言阅读</p>
      <h1>一首诗，可以中文读，也可以英文读</h1>
      <p class="lead">每一首诗都不只放原文。页面补上注释、今译、英译、背景、赏析、主题路径和相关诗词。</p>
      <p><a class="button" href="/poems/jing-ye-si">Read today's poem</a></p>
    </div>
  </section>

  <section class="feature-grid" aria-label="Poetry discovery paths">
    <a href="/daily/today">
      <span>今日诗笺</span>
      <strong>每日一首，适合邮件和社媒分发。</strong>
    </a>
    <a href="/themes/homesickness">
      <span>主题路径</span>
      <strong>按乡思、月夜、送别等主题串联内容。</strong>
    </a>
    <a href="/en/poems/jing-ye-si">
      <span>English route</span>
      <strong>给海外搜索和 AI 摘要提供独立英文入口。</strong>
    </a>
  </section>

  <section class="section">
    <h2 class="section-title">今日推荐</h2>
    <div class="daily-card">
      <p class="kicker">Li Bai · Tang Dynasty</p>
      <h3>静夜思 · Quiet Night Thoughts</h3>
      <p>床前明月光，疑是地上霜。页面包含原文、行间注释、今译、英译、赏析和来源说明。</p>
      <p><a class="text-link" href="/poems/jing-ye-si">阅读全文</a></p>
    </div>
  </section>

  <AdSlot slot="feedInline" />
  <SubscriptionPanel />
</BaseLayout>

<style>
  .hero {
    border-top: 1px solid var(--line);
    padding: 72px 0;
  }

  .kicker {
    color: var(--cinnabar);
    font-weight: 700;
  }

  h1 {
    max-width: 760px;
    margin: 0;
    font-size: clamp(42px, 6vw, 78px);
    line-height: 1.08;
  }

  .lead {
    max-width: 680px;
    color: var(--muted);
    font-size: 18px;
  }

  .button {
    display: inline-block;
    background: var(--teal);
    color: var(--paper-2);
    padding: 12px 18px;
    text-decoration: none;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .feature-grid a,
  .daily-card {
    border: 1px solid var(--line);
    background: rgba(255, 249, 234, 0.68);
  }

  .feature-grid a {
    display: grid;
    gap: 10px;
    min-height: 136px;
    padding: 18px;
    text-decoration: none;
  }

  .feature-grid span {
    color: var(--cinnabar);
    font-size: 14px;
    font-weight: 700;
  }

  .feature-grid strong {
    color: var(--teal);
    font-size: 19px;
    line-height: 1.45;
  }

  .daily-card {
    max-width: 760px;
    padding: 22px;
  }

  .daily-card h3 {
    margin: 0;
    color: var(--teal);
    font-size: 28px;
  }

  .text-link {
    color: var(--cinnabar);
    font-weight: 700;
  }

  @media (max-width: 820px) {
    .feature-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
