---
import { getCollection } from "astro:content";
import AdSlot from "@/components/AdSlot.astro";
import PoemReader from "@/components/PoemReader.astro";
import { getSiteConfig } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { displayPoetName, isIndexablePoem } from "@/lib/content/poems";
import { buildHreflangLinks, pageRobots } from "@/lib/seo/meta";
import { breadcrumbJsonLd, poemJsonLd } from "@/lib/seo/structured-data";

export const prerender = true;

export async function getStaticPaths() {
  const poems = await getCollection("poems");
  const poets = await getCollection("poets");
  return poems.filter(isIndexablePoem).map((poem) => ({ params: { slug: poem.slug }, props: { poem, poets } }));
}

const { poem, poets } = Astro.props;
const data = poem.data;
const site = getSiteConfig();
const poemPath = `/poems/${poem.slug}`;
const englishPoemPath = `/en/poems/${poem.slug}`;
const poetName = displayPoetName(poem, poets);
---

<BaseLayout
  title={`${data.title} - ${poetName.zh} - 未名诗阁`}
  description={data.explanationZh || `${data.title} 原文、注释、今译和赏析。`}
  canonicalPath={poemPath}
  robots={pageRobots(isIndexablePoem(poem))}
  alternates={buildHreflangLinks(site.url, { zh: poemPath, en: englishPoemPath })}
  jsonLd={[
    poemJsonLd({
      siteUrl: site.url,
      path: poemPath,
      title: data.title,
      author: poetName.zh,
      language: "zh-CN"
    }),
    breadcrumbJsonLd(site.url, [
      { name: "Poems", path: "/poems" },
      { name: data.title, path: poemPath }
    ])
  ]}
>
  <PoemReader
    title={data.title}
    titleEn={data.titleEn}
    poet={poetName.zh}
    dynasty={data.dynasty}
    themes={data.themes}
    lines={data.lines}
  />
  <AdSlot slot="poemAfterIntro" />
  <section class="section">
    <h2 class="section-title">今译与赏析</h2>
    <p>{data.explanationZh}</p>
    <p>{data.commentaryZh}</p>
  </section>
  <section class="section">
    <h2 class="section-title">来源与审校</h2>
    <p>{data.source}</p>
    <p>{data.license}</p>
    <p>Updated: {data.updated}</p>
  </section>
</BaseLayout>
