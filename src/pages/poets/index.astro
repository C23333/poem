---
import { getCollection } from "astro:content";
import { getSiteConfig } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { entrySlug } from "@/lib/content/entries";
import { collectionPageJsonLd } from "@/lib/seo/structured-data";

export const prerender = true;

const poets = await getCollection("poets");
const site = getSiteConfig();
---

<BaseLayout
  title="诗人索引 - 未名诗阁"
  description="浏览站点收录的诗人。"
  canonicalPath="/poets"
  jsonLd={collectionPageJsonLd({
    siteUrl: site.url,
    path: "/poets",
    name: "诗人索引",
    description: "浏览站点收录的诗人。"
  })}
>
  <section class="section">
    <h1>诗人索引</h1>
    <p>诗人页用于连接作品、朝代、主题和英文读者入口。</p>
  </section>

  <section class="index-grid">
    {poets.map((poet) => (
      <a href={`/poets/${entrySlug(poet)}`}>
        <strong>{poet.data.name}</strong>
        <span>{poet.data.nameEn}</span>
        <small>{poet.data.summaryZh}</small>
      </a>
    ))}
  </section>
</BaseLayout>

<style>
  h1 {
    color: var(--teal);
    font-size: 48px;
  }

  .index-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 14px;
    margin: 28px 0 64px;
  }

  .index-grid a {
    display: grid;
    gap: 6px;
    border: 1px solid var(--line);
    background: rgba(255, 249, 234, 0.68);
    padding: 16px;
    text-decoration: none;
  }

  .index-grid span,
  .index-grid small {
    color: var(--muted);
  }
</style>
